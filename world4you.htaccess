# kalenderkompass24.de – Konfiguration für den Webspace bei World4You (Apache)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
# Einheitliche Adresse ohne www (HTTP→HTTPS erledigt World4You über „HTTPS erzwingen“).
# Auch Aufrufe über adstern.com/<verzeichnis>/… landen so auf der eigenen Domain.
RewriteCond %{HTTP_HOST} !^kalenderkompass24\.de$ [NC]
RewriteRule ^(.*)$ https://kalenderkompass24.de/$1 [R=301,L]
# /seite → /seite.html (wie bisher bei GitHub Pages)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js|webp|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml text/plain
</IfModule>
AddType image/webp .webp
AddType font/woff2 .woff2
AddType text/calendar .ics
